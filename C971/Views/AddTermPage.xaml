<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C971.Views.AddTermPage"
             Title="Add Term">
    
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Term Title:" FontSize="18"/>
        <Entry x:Name="TermTitleEntry" Placeholder="Term Title"/>

        <Label Text="Start Date:" FontSize="18"/>
        <DatePicker x:Name="StartDatePicker"/>

        <Label Text="End Date:" FontSize="18"/>
        <DatePicker x:Name="EndDatePicker"/>

        <Button Text="Save Term" Clicked="OnSaveTermClicked"/>
    </VerticalStackLayout>
</ContentPage>