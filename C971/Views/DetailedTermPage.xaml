<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C971.Views.DetailedTermPage"
             xmlns:model="clr-namespace:C971.Model"
             Title="Term Details"
              BackgroundColor="WhiteSmoke">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit"
                     Order="Primary"
                     Clicked="OnEditClicked"/>

        <ToolbarItem Text="Delete"
                     Order="Primary"
                     Clicked="OnDeleteClicked"/>
    </ContentPage.ToolbarItems>

    <Grid>
        <ScrollView>
        <StackLayout Padding="15">
                <Label Text="{Binding Title}" FontSize="30" FontFamily="RobotoBold" FontAttributes="Bold" Margin="10,20,0,0" TextColor="#333333"/>
                <Label Text="{Binding DateRange}" FontSize="16" FontFamily="RobotoRegular" TextColor="Gray" Margin="10,10,0,0"/>

            <Label Text="Courses"
               FontSize="20"
               TextColor="#003366"
               FontAttributes="Bold"
               HorizontalOptions="Start"
               Margin="10,50,0,5"/>

                <StackLayout x:Name="NoCoursesAdded">
                    <Label Text="&#x2750;" HorizontalOptions="Center" TextColor="Gray" FontSize="150" Margin="0,20,0,0"/>
                    <Label Text="No courses added." HorizontalOptions="Center" TextColor="Gray" FontSize="18"/>
                    <Label Text="Tap the + button to add a course." HorizontalOptions="Center" TextColor="Gray" FontSize="18"/>
                </StackLayout>

                <CollectionView x:Name="CoursesCollectionView"
                            ItemsSource="{Binding Courses}"
                            SelectionMode="Single"
                            SelectionChanged="OnCourseSelected">
                    
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:Course">
                            <Grid Padding="5">
                                <Border BackgroundColor="White"                          
                            StrokeShape="RoundRectangle 10,10"   
                            Stroke="Transparent"
                            Padding="10"
                            Margin="0,10,0,0">

                                <Border.Shadow>
                                    <Shadow Brush="Gray"
                                            Offset="0,10"
                                            Radius="10"
                                            Opacity="1"/>
                                </Border.Shadow>


                        <VerticalStackLayout Padding="10" 
                                             Spacing="10" 
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold"/>
                            <Label Text="{Binding CourseDateRange}" FontSize="14" TextColor="Gray"/>
                            <Label Text="{Binding Status}" FontSize="14" TextColor="Gray"/>
                        </VerticalStackLayout>
                    </Border>
                            </Grid>
                        </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
            
        </StackLayout>
        </ScrollView>

        <AbsoluteLayout VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
            <Button Text="+"
            BackgroundColor="#003366"
            TextColor="White"
            CornerRadius="50"
            WidthRequest="80"
            HeightRequest="80"
            FontSize="Large"
            Clicked="OnAddCourseClicked"
            AbsoluteLayout.LayoutBounds="0.9,0.96,AutoSize,AutoSize"
            AbsoluteLayout.LayoutFlags="PositionProportional"/>
        </AbsoluteLayout>
    </Grid>
</ContentPage>