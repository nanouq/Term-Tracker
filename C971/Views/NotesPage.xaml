<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="C971.Views.NotesPage"
             Title="Notes">

    <VerticalStackLayout Padding="20">
        <Label x:Name="AddEditLabel" Text="Add note:" FontSize="Large" FontAttributes="Bold"/>

        <Editor x:Name="NotesEditor" AutoSize="TextChanges"></Editor>

        <Button x:Name="SaveButton" Text="Save Note" Clicked="OnSaveClicked" BackgroundColor="#003366" FontAttributes="Bold"/>

    </VerticalStackLayout>
</ContentPage>